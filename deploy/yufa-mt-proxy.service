[Unit]
Description=yufa-mt proxy (connection owner: PIN + zone proxies, IPC server)
After=network.target

[Service]
# The connection-owning half of the split deployment (see
# docs/two-process-split-plan.md). It holds the live game client<->server TCP
# connection via the PIN/zone iptables REDIRECT, so it is restarted RARELY —
# the app unit (yufa-mt-app.service) is what the "Pull, Rebuild & Restart"
# button restarts, and it must NOT disturb this process.
User=dns
Group=dns

# CAP_NET_ADMIN: modify the nat table (REDIRECT rules) + SO_MARK fwmark on the
# proxies' onward sockets. CAP_NET_RAW: iptables-legacy (xtables-legacy-multi)
# talks to netfilter over a RAW socket, whose creation requires CAP_NET_RAW —
# so iptables fails with "Permission denied (you must be root)" if it's missing,
# even with CAP_NET_ADMIN. Both are needed; this mirrors the original single
# unit. (The app unit also carries CAP_NET_RAW, for libpcap chat capture.)
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

WorkingDirectory=/home/dns/git/yufa-mt/
EnvironmentFile=/home/dns/git/yufa-mt/.env
Environment=YUFA_MODE=proxy

# This unit OWNS /run/yufa-mt: it holds both the iptables lock and the IPC
# socket the app connects to. RuntimeDirectoryPreserve=yes keeps the directory
# (and the socket path) alive across an app restart and even a brief proxy
# restart, so the app's reconnect finds the path in place.
RuntimeDirectory=yufa-mt
RuntimeDirectoryPreserve=yes
Environment=XTABLES_LOCKFILE=/run/yufa-mt/xtables.lock
Environment=PROXY_IPC_SOCKET=/run/yufa-mt/proxy.sock

ExecStart=/home/dns/git/yufa-mt/yufa-mt --mode=proxy

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
