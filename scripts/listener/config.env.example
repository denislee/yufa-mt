# yufa-listener configuration overrides.
# Copy to ~/.config/yufa-listener/config.env and edit as needed.
# Every value here is optional; unset values fall back to the script defaults.

# --- Display ---
# DISPLAY_NUM=":99"
# SCREEN_GEOMETRY="640x480x16"   # keep small + low depth for minimum resources

# --- Which Lutris game to launch (see: lutris -l -j) ---
# 4 = slug "ragnarok-online-1" -> wine_prefix_2 (the newest config)
# LUTRIS_GAME_ID="4"
# GAME_PROC="Projeto_Yufa.exe"
# WINDOW_NAME="Ragnarok"          # xdotool window-name regex; check a `shot` if login fails

# --- Login timing (seconds). Tune using `yufa-listener.sh shot` between steps ---
# WAIT_FOR_WINDOW="180"
# SETTLE_AFTER_WINDOW="45"        # increase if Gepard init is slow on this box
# WAIT_AFTER_LOGIN="12"
# WAIT_BEFORE_CHARSELECT="6"
# WAIT_MAP_LOAD="25"
# KEY_DELAY_MS="60"

# --- Optional mouse clicks (only if Enter-only navigation doesn't work) ---
# LOGIN_FIELD_CLICK="320,210"     # click the ID field before typing
# CHAR_SELECT_CLICK="110,180"     # click the character slot before Enter

# --- Rendering fallback ---
# If the client won't render under Xvfb (black screenshot, no window), force
# software D3D9 instead of the GPU/DXVK path:
# EXTRA_ENV="PROTON_USE_WINED3D=1"
