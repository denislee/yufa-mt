# yufa-listener configuration overrides.
# Copy to ~/.config/yufa-listener/config.env and edit as needed.
# Every value here is optional; unset values fall back to the script defaults.

# --- Display ---
# DISPLAY_NUM=":99"
# SCREEN_GEOMETRY="640x480x16"   # keep small + low depth for minimum resources

# --- Launch (direct umu-run; NOT lutris, which resets DISPLAY/drops env) ---
# UMU_RUN="$HOME/.local/share/lutris/runtime/umu/umu-run"
# PROTONPATH="$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton10-34"
# WINEPREFIX_DIR="/home/dns/Downloads/Projeto Yufa/wine_prefix_2"
# GAME_EXE="/home/dns/Downloads/Projeto Yufa/Projeto_Yufa.exe"
# WINDOW_NAME="Gepard Shield"     # window title regex; confirm with a `shot`

# Required headless: Xvfb's Intel Vulkan has no X11 presentable surface, so DXVK
# can't make a window. wined3d (D3D9->OpenGL->llvmpipe) renders fine on Xvfb.
# EXTRA_ENV="PROTON_USE_WINED3D=1"

# --- Login timing (seconds). Tune using `yufa-listener.sh shot` between steps ---
# SETTLE_AFTER_WINDOW="60"        # initial wait before polling for the login window
# LOGIN_READY_TRIES="40"          # x2s poll dismissing the startup popup
# WAIT_AFTER_LOGIN="10"
# WAIT_BEFORE_PIN="4"
# WAIT_BEFORE_CHARSELECT="6"
# WAIT_MAP_LOAD="25"
# KEY_DELAY_MS="70"

# --- Login mode ---
# The client's "Salvar Login" remembers the account and LOCKS the ID field, so
# typing into it is ignored. With saved-login on (default) we don't touch the ID
# field; we only fill the password + PIN. You must log in once manually as the
# desired account IN THIS PREFIX with "Salvar Login" checked so it's remembered.
# USE_SAVED_LOGIN="1"             # set 0 to type the ID (LOGIN_ID_CLICK) instead

# --- Click coordinates "X,Y" (window pinned to 0,0; calibrated for 640x480) ---
# WINDOW_PIN_XY="0,0"
# DIALOG_OK_CLICK="322,265"       # OK of the startup "HatEFID nil" Lua popup
# LOGIN_ID_CLICK="281,305"        # only used when USE_SAVED_LOGIN=0
# LOGIN_PW_CLICK="285,328"
# LOGIN_BUTTON_CLICK="420,308"
# PIN_CLICK=""                    # PIN field focus click, if needed
# CHAR_SELECT_CLICK=""            # character slot before Enter, if needed
