# yufa-listener configuration overrides.
# Copy to ~/.config/yufa-listener/config.env and set only what you need.
#
# Almost everything auto-detects, so on a new machine this file can be nearly
# empty. Auto-detected (override here only if detection picks wrong):
#   RUN_MODE        -> "real" (the working mode)
#   REAL_DISPLAY    -> $DISPLAY or :0
#   LUTRIS_GAME_ID  -> looked up from `lutris -l -j` by matching the RO game
#   GAME_DIR/GAME_EXE/WINEPREFIX_DIR -> read from the Lutris game's .yml
#   GAME_PROC       -> basename of the exe
#   PROTONPATH      -> newest GE-Proton in compatibilitytools.d
#   UMU_RUN         -> lutris runtime umu-run (or $PATH)
#   CHAT_CAPTURE_DEVICE -> default-route NIC (in run-sniffer.sh)

# Which Lutris game is the RO client (matched against the exe path). The default
# matches Projeto Yufa / generic ragexe / Ragnarok.
# GAME_EXE_PATTERN="Projeto_Yufa|[Rr]agexe|[Rr]agnarok"

# Server-specific: the game/zone server TCP port chat flows on. Find it while
# in-game with:  ss -tn | grep Projeto   (the foreign port)
CHAT_CAPTURE_PORT="6121"

# Override auto-detection only if needed, e.g.:
# RUN_MODE="real"
# LUTRIS_GAME_ID="4"
# GAME_DIR="/path/to/Projeto Yufa"
# CHAT_CAPTURE_DEVICE="eth0"

# --- Headless mode only (login is blocked there; for record) -----------------
# SCREEN_GEOMETRY="640x480x16"; USE_WM="1"; EXTRA_ENV="PROTON_USE_WINED3D=1"
# WINDOW_NAME="Gepard Shield"; LOGIN_PW_CLICK="285,328"; LOGIN_BUTTON_CLICK="420,308"
# DIALOG_OK_CLICK="322,265"; PIN_CLICK=""; CHAR_SELECT_CLICK=""
