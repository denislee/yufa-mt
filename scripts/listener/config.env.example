# yufa-listener configuration overrides.
# Copy to ~/.config/yufa-listener/config.env and set only what you need.
#
# Almost everything auto-detects, so on a new machine this file can be nearly
# empty. Auto-detected (override here only if detection picks wrong):
#   RUN_MODE        -> "real" (the working mode)
#   REAL_DISPLAY    -> $DISPLAY or :0
#   LUTRIS_GAME_ID  -> looked up from `lutris -l -j` by matching the RO game
#   GAME_DIR/GAME_EXE/WINEPREFIX_DIR -> read from the Lutris game's .yml
#   GAME_PROC       -> basename of the exe
#   PROTONPATH      -> newest GE-Proton in compatibilitytools.d
#   UMU_RUN         -> lutris runtime umu-run (or $PATH)
#   CHAT_CAPTURE_DEVICE -> default-route NIC (in run-sniffer.sh)

# Which Lutris game is the RO client (matched against the exe path). The default
# matches Projeto Yufa / generic ragexe / Ragnarok.
# GAME_EXE_PATTERN="Projeto_Yufa|[Rr]agexe|[Rr]agnarok"

# Server-specific: the game/zone server TCP port chat flows on. Find it while
# in-game with:  ss -tn | grep Projeto   (the foreign port)
CHAT_CAPTURE_PORT="6121"

# --- In-app character-select PIN proxy ---------------------------------------
# yufa-mt runs the PIN-injection proxy in-process (replacing the old root
# yufa-mitm-proxy service). run-sniffer.sh auto-enables it when YUFA_PIN is set
# in credentials.env; the binary needs cap_net_admin (the documented setcap).
# PIN_PROXY="0"                  # force-disable even when YUFA_PIN is set
# PIN_PROXY_SELECT_SLOT="0"      # also auto-pick this char slot (empty = PIN only)
# PIN_PROXY_CHAR_PORT="7121"     # char-server port carrying the cleartext PIN packets
# PIN_PROXY_LISTEN_PORT="7799"   # local port the REDIRECT delivers to
# PIN_PROXY_SERVER_IP=""         # narrow the redirect to one server IP (optional)
# PIN_PROXY_INJECT="1"           # 0 = pure transparent relay (debug, no injection)

# Override auto-detection only if needed, e.g.:
# RUN_MODE="real"
# LUTRIS_GAME_ID="4"
# GAME_DIR="/path/to/Projeto Yufa"
# CHAT_CAPTURE_DEVICE="eth0"

# --- Headless mode only (login is blocked there; for record) -----------------
# SCREEN_GEOMETRY="640x480x16"; USE_WM="1"; EXTRA_ENV="PROTON_USE_WINED3D=1"
# WINDOW_NAME="Gepard Shield"; LOGIN_PW_CLICK="285,328"; LOGIN_BUTTON_CLICK="420,308"
# DIALOG_OK_CLICK="322,265"; PIN_CLICK=""; CHAR_SELECT_CLICK=""

# --- Real-display ydotool test (rtest subcommand) ----------------------------
# YDOTOOL_SOCKET="/tmp/.ydotool_socket"   # must match `sudo ydotoold -p ...`
# RTEST_FOCUS_DELAY="6"                   # seconds to focus the login window first

# --- Liveness / reconnect watchdog (yufa-listener.sh run) --------------------
# monitor() relaunches the client when its process dies; with ZONE_WATCHDOG=1 it
# ALSO relaunches + re-logs-in when the client loses its zone connection for too
# long (kicked back to login, AFK timeout, or a mistimed auto-login) — the case
# a bare process check misses. ZONE_PORT defaults to CHAT_CAPTURE_PORT (6121).
# ZONE_WATCHDOG="1"          # set 0 for old process-liveness-only behaviour
# MONITOR_INTERVAL="15"      # seconds between polls
# DISCONNECT_GRACE="90"      # max seconds with no zone link before relaunch
#                            # (must exceed a normal login -> map-load time)
# ZONE_PORT="6121"           # override only if your zone port differs
