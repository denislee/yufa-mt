# Projeto Yufa account used by the headless chat listener.
# Copy to ~/.config/yufa-listener/credentials.env and chmod 600 it:
#
#   install -m700 -d ~/.config/yufa-listener
#   cp credentials.env.example ~/.config/yufa-listener/credentials.env
#   chmod 600 ~/.config/yufa-listener/credentials.env
#   $EDITOR ~/.config/yufa-listener/credentials.env
#
# Use a dedicated, low-value account parked AFK in a busy town (e.g. Prontera).
YUFA_USER="your_account_id"
YUFA_PASS="your_password"
